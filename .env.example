# First-visit theme: dark, light or system (follows prefers-color-scheme).
# A visitor's saved theme toggle choice overrides this default.
APP_THEME=dark

# Development / local only
AUTH_MODE=dev
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=0
BASE_URL=http://localhost:8080

# Production behind the auth proxy
# AUTH_MODE=proxy
# SECRET_KEY=generate-with-python-secrets
# PN_ENCRYPTION_KEY=optional-separate-key
# PROXY_SHARED_SECRET=optional-shared-secret-between-proxy-and-app
# COOKIE_SECURE=1
# BASE_URL=https://verify.example.se
# ALLOWED_ORIGINS=https://verify.example.se,https://verify-alias.example.se
# PROXY_LOGOUT_URL=https://sso.example.se/logout
